# Nocode Backend
NOCODE_API_URL="http://localhost:3000"
NOCODE_APP_ID="1"
NOCODE_ORG_ID="org_xxxxxxxxxxxx"
NOCODE_ADMIN_TOKEN="AAGA_admin-key-for-setup-script"
NOCODE_SYSTEM_TOKEN="AAGA_system-key-for-server-calls"

# NextAuth (the dev server runs on port 4000)
NEXTAUTH_URL="http://localhost:4000"
NEXTAUTH_SECRET="generate-a-secret-with-openssl-rand-base64-32"

# Payments (Razorpay) and file uploads (Cloudinary) are connected as integrations
# on the nocode organization, not configured here. See README steps 4 and 5.

# Email (SMTP). EMAIL_FROM defaults to SMTP_USER.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="you@example.com"
SMTP_PASS="app-password"
EMAIL_FROM=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:4000"
NEXT_PUBLIC_APP_NAME="Open Slate"

# Beefree SDK (visual email builder) - https://developers.beefree.io
BEEFREE_CLIENT_ID=""
BEEFREE_CLIENT_SECRET=""
